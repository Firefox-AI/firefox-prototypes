{
  "manifest_version": 2,
  "name": "Smart Window Auto Grouping (prototype)",
  "version": "0.3.0",
  "description": "Prototype of Smart Window auto grouping as a WebExtension: new tabs join a matching tab group or form a new group once three related tabs are open, and opening a page that is already open jumps to the existing tab instead of a duplicate. Passive by default, with a toolbar menu to turn it off or undo.",
  "browser_specific_settings": {
    "gecko": {
      "id": "smart-auto-grouping@prototype.mozilla.org",
      "strict_min_version": "139.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "webNavigation"
  ],
  "optional_permissions": [
    "trialML"
  ],
  "background": {
    "scripts": [
      "classifier.js",
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Organize tabs",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg"
    },
    "theme_icons": [
      {
        "light": "icons/icon-light.svg",
        "dark": "icons/icon.svg",
        "size": 16
      },
      {
        "light": "icons/icon-light.svg",
        "dark": "icons/icon.svg",
        "size": 32
      }
    ]
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
